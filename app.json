  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Error has occured",
          "sv": "Ett fel har inträffat"
        },
        "hint": {
          "en": "This flowcard triggers when an error occurs on the heat pump.",
          "sv": "Det här flödeskortet triggas när ett fel inträffar i värmepumpen."
        },
        "platforms": [
          "local"
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heat-pump"
          }
        ],
        "tokens": [
          {
            "name": "code",
            "type": "string",
            "title": {
              "en": "Error code",
              "sv": "Felkod"
            },
            "example": "5284"
          },
          {
            "name": "description",
            "type": "string",
            "title": {
              "en": "Error description",
              "sv": "Felbeskrivning"
            },
            "example": "Connection terminal MC15 and MC16 not equipped with bridge or temperature limiter"
          }
        ],
        "id": "alarm_status_error"
      },
      {
        "title": {
          "en": "Error resolved",
          "sv": "Felet löst"
        },
        "hint": {
          "en": "This flowcard triggers when all of the errors are resolved in the heatpump.",
          "sv": "Det här flödeskortet triggas när alla fel har åtgärdats i värmepumpen."
        },
        "platforms": [
          "local"
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heat-pump"
          }
        ],
        "id": "alarm_status_ok"
      }
    ],
    "conditions": [
      {
        "id": "hotwater_mode_is",
        "title": {
          "en": "Hot water mode !{{is|is not}}",
          "sv": "Varmvattenläge !{{är|är inte}}"
        },
        "titleFormatted": {
          "en": "Hot water mode !{{is|is not}} [[mode]]",
          "sv": "Varmvattenläge !{{är|är inte}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heat-pump"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "title": {
              "en": "Mode",
              "sv": "Läge"
            },
            "values": [
              {
                "id": "eco",
                "label": {
                  "en": "Eco",
                  "sv": "Eco"
                }
              },
              {
                "id": "low",
                "label": {
                  "en": "Low",
                  "sv": "Låg"
                }
              },
              {
                "id": "high",
                "label": {
                  "en": "High",
                  "sv": "Hög"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "compressor_is_running",
        "title": {
          "en": "Compressor !{{is|is not}} running",
          "sv": "Kompressorn !{{är|är inte}} igång"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heat-pump"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_hotwater_mode",
        "title": {
          "en": "Set hot water mode",
          "sv": "Ställ in varmvattenläge"
        },
        "titleFormatted": {
          "en": "Set hot water mode to [[mode]]",
          "sv": "Ställ in varmvattenläge till [[mode]]"
        },
        "hint": {
          "en": "Switch the heat pump between the Eco, Low and High hot water modes.",
          "sv": "Växla värmepumpen mellan varmvattenlägena Eco, Låg och Hög."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heat-pump"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "title": {
              "en": "Mode",
              "sv": "Läge"
            },
            "values": [
              {
                "id": "eco",
                "label": {
                  "en": "Eco",
                  "sv": "Eco"
                }
              },
              {
                "id": "low",
                "label": {
                  "en": "Low",
                  "sv": "Låg"
                }
              },
              {
                "id": "high",
                "label": {
                  "en": "High",
                  "sv": "Hög"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "extra_hot_water",
        "title": {
          "en": "Start extra hot water",
          "sv": "Starta extra varmvatten"
        },
        "hint": {
          "en": "Request a one-off extra hot water charge from the heat pump.",
          "sv": "Begär en extra varmvattenladdning från värmepumpen."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heat-pump"
          }
        ]
      },
      {
        "id": "set_hotwater_temperature",
        "title": {
          "en": "Set hot water temperature",
          "sv": "Ställ in varmvattentemperatur"
        },
        "titleFormatted": {
          "en": "Set hot water temperature for [[level]] mode to [[temperature]] °C",
          "sv": "Ställ in varmvattentemperatur för läge [[level]] till [[temperature]] °C"
        },
        "hint": {
          "en": "Changes the target temperature of the Low or High hot water mode (40–52 °C). The Eco temperature cannot be changed remotely.",
          "sv": "Ändrar måltemperaturen för varmvattenläget Låg eller Hög (40–52 °C). Eco-temperaturen kan inte ändras på distans."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heat-pump"
          },
          {
            "name": "level",
            "type": "dropdown",
            "title": {
              "en": "Mode",
              "sv": "Läge"
            },
            "values": [
              {
                "id": "low",
                "label": {
                  "en": "Low",
                  "sv": "Låg"
                }
              },
              {
                "id": "high",
                "label": {
                  "en": "High",
                  "sv": "Hög"
                }
              }
            ]
          },
          {
            "name": "temperature",
            "type": "number",
            "title": {
              "en": "Temperature",
              "sv": "Temperatur"
            },
            "placeholder": {
              "en": "e.g. 45",
              "sv": "t.ex. 45"
            },
            "min": 40,
            "max": 52,
            "step": 1
          }
        ]
      }
    ]
  },
